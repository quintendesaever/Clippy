# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Application ID (Discord Developer Portal → General Information)
CLIENT_ID=your_application_id_here

# Required: your single Discord server ID (guild-scoped slash commands)
GUILD_ID=your_guild_id_here

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Dashboard (Discord OAuth + web UI)
CLIENT_SECRET=your_client_secret_here
SESSION_SECRET=your_session_secret_here
DASHBOARD_URL=https://dashboard.clippybot.be
# Optional override for Discord link buttons when DASHBOARD_URL is localhost
# PUBLIC_DASHBOARD_URL=https://dashboard.clippybot.be
DASHBOARD_PORT=3000

# Optional: enable Cloudflare "Add visitor location headers" on dashboard.clippybot.be
# so analytics can store country/region/city without retaining IP addresses.
# No extra API key is required.

# Home server: Cloudflare Tunnel token (Zero Trust → Tunnels → Docker connector)
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Optional: F1 reminder test mode (1 = short intervals)
# F1_REMINDER_TEST=1

# Optional fallback for the F1 "Make predictions" button.
# Prefer configuring this per server with /f1-reminder set-prediction-url
# F1_PREDICTION_URL=https://example.com/f1-predictions
