# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Application ID (Discord Developer Portal → General Information)
CLIENT_ID=your_application_id_here

# Required: your single Discord server ID (guild-scoped slash commands)
GUILD_ID=your_guild_id_here

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Dashboard (Discord OAuth + web UI)
CLIENT_SECRET=your_client_secret_here
SESSION_SECRET=your_session_secret_here
DASHBOARD_URL=https://dashboard.clippybot.be
DASHBOARD_PORT=3000

# Home server: Cloudflare Tunnel token (Zero Trust → Tunnels → Docker connector)
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Optional: F1 reminder test mode (1 = short intervals)
# F1_REMINDER_TEST=1
