# Production runtime secrets live ONLY on the host:
#   /data/deployments/clippy/production/.env  (mode 0600)
# Until CD cutover, live production remains:
#   /data/apps/clippy/.env
#
# Required keys match .env.example plus:
#   CLOUDFLARE_TUNNEL_TOKEN=<from /data/ai-platform/secrets/clippy-cloudflare-tunnel-token>
#
# Do not store production values in Git or GitHub Actions secrets.
